{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DinnerRollShortcutPayload",
  "type": "object",
  "required": ["source", "version", "timestamp", "items"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["DinnerRoll"]
    },
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "display", "section"],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "display": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    }
  },
  "examples": [
    {
      "source": "DinnerRoll",
      "version": "1.0",
      "timestamp": "2026-09-05T10:00:00.000Z",
      "items": [
        {
          "name": "Chicken Breast",
          "quantity": 800,
          "unit": "g",
          "display": "800 g Chicken Breast",
          "section": "Meat"
        },
        {
          "name": "Lemon",
          "quantity": 2,
          "unit": "item",
          "display": "2 item Lemon",
          "section": "Produce"
        },
        {
          "name": "Olive Oil",
          "quantity": 30,
          "unit": "ml",
          "display": "30 ml Olive Oil",
          "section": "Pantry"
        }
      ]
    }
  ]
}
