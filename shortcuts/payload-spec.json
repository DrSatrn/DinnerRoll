{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DinnerRollShortcutPayload",
  "type": "object",
  "required": ["source", "version", "timestamp", "items", "plainText"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["DinnerRoll"]
    },
    "version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "listName": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detailedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "display", "section"],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "display": { "type": "string" },
          "section": { "type": "string" }
        }
      }
    },
    "plainText": {
      "type": "string"
    }
  },
  "examples": [
    {
      "source": "DinnerRoll",
      "version": "2.0",
      "timestamp": "2026-09-05T10:00:00.000Z",
      "listName": "Family Shopping",
      "items": [
        "800 g Chicken Breast",
        "2 item Lemon",
        "30 ml Olive Oil"
      ],
      "plainText": "800 g Chicken Breast\n2 item Lemon\n30 ml Olive Oil"
    }
  ]
}
